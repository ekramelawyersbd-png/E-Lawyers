rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Tax Calculations Collection
    match /taxCalculations/{calcId} {
      // Allow read/write if the document's userId matches the authenticated user
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Allow create if the new document's userId matches the authenticated user
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // Favorites Collection
    match /favorites/{favoriteId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Professional Discussions & Comments Collection
    match /comments/{commentId} {
      // Any reader can read comments on legal articles
      allow read: if true;
      // Allow creation if articleId, authorName, and text are provided
      allow create: if (isAuthenticated() || request.resource.data.authorName is string)
                    && request.resource.data.articleId is string
                    && request.resource.data.authorName is string
                    && request.resource.data.text is string;
      // Allow updating helpful/endorsement count, or if author updates their comment
      allow update: if true;
      // Allow author to delete their own comment
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOwner(resource.data.userId));
    }

    // Professional Legal & Tax Newsletter Subscribers
    match /newsletterSubscribers/{subscriberId} {
      // Allow reading for subscribers or admin/system
      allow read: if true;
      // Allow any visitor to subscribe with valid email formatting
      allow create, update: if request.resource.data.email is string 
                            && request.resource.data.email.size() <= 150
                            && request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$');
      // Allow unsubscribing/deleting if owner
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email);
    }

    // Client Testimonials & Success Stories Collection
    match /testimonials/{testimonialId} {
      // Publicly readable for trust and social proof
      allow read: if true;
      // Allow authenticated clients or verified users to submit success stories
      allow create: if request.resource.data.clientName is string
                    && request.resource.data.story is string
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      // Allow updates or deletion
      allow update, delete: if isAuthenticated();
    }

    // Digital Shop Products Collection
    match /products/{productId} {
      // Publicly readable for all visitors in the shop
      allow read: if true;
      // Allow management of shop products
      allow write: if true;
    }

    // Career Job Applications Collection
    match /jobApplications/{applicationId} {
      // Allow authenticated applicant to read, update or withdraw their own applications
      allow read, update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email);
      // Allow applicant to submit a job application record
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || request.resource.data.userEmail == request.auth.token.email);
    }

    // Consultation Appointments Collection
    match /appointments/{appointmentId} {
      // Allow public creation with valid client details
      allow create: if request.resource.data.clientName is string
                    && request.resource.data.email is string
                    && request.resource.data.practiceArea is string
                    && request.resource.data.date is string;
      // Allow read and manage if authenticated client/staff or matches email
      allow read, update, delete: if isAuthenticated();
    }

    // Automated Email Notifications Collection
    match /emailNotifications/{notificationId} {
      // Allow authenticated user or recipient to view their automated notification audit logs
      allow read: if isAuthenticated();
      // Allow system, functions, or booking triggers to create audit logs
      allow create: if isAuthenticated() 
                    || (request.resource.data.recipientEmail is string && request.resource.data.status is string);
      // Notification logs are immutable records
      allow update, delete: if false;
    }

    // LMS Student Enrollments & Profiles
    match /lms_enrollments/{userId} {
      allow read, write: if isOwner(userId);
    }

    // LMS Sequential Class Progress Records
    match /lms_progress/{progressKey} {
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // LMS Class Quiz Attempts
    match /lms_attempts/{attemptId} {
      allow get, list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // LMS Final Examination Results
    match /lms_exam_results/{resultId} {
      allow get, list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // LMS Certificates Registry (Publicly verifiable by Certificate ID)
    match /lms_certificates/{certificateId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // LMS Course Curriculum Configurations
    match /lms_courses/{courseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // LMS Administrative Audit Logs
    match /lms_audit_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}


